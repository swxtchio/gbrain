[Unit]
Description=gbrain HTTP MCP server liveness probe (restarts a hung gbrain-http.service)
Documentation=file://%h/gbrain/deploy/local-http/README.md

[Service]
Type=oneshot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# setup.sh installs gbrain-http-liveness.sh under ~/.local/share/gbrain/libexec and renders that path.
ExecStart=@LIVENESS_SCRIPT@
