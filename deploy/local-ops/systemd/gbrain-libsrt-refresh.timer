[Unit]
Description=Weekly libsrt drift refresh — Sundays 02:00 local
Requires=gbrain-libsrt-refresh.service

[Timer]
# Sunday at 02:00 local time
OnCalendar=Sun *-*-* 02:00:00
# If the box was off at the trigger time, run on next boot
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
