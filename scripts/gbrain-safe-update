#!/usr/bin/env bash
#
# gbrain-safe-update — upgrade gbrain without destroying your fork customizations.
#
# Why this exists:
#   This gbrain checkout is a swxtch FORK: `origin` mirrors upstream (garrytan/gbrain,
#   default branch `master`) and your work lives on the `swxtch` branch (pushed to
#   swxtchio/gbrain), where the in-code deltas are marked `SWX` in a comment on the
#   changed line. The documented upgrade (`git pull origin master`)
#   assumes a vanilla `master` checkout — run from `swxtch` it would merge upstream INTO
#   your fork (or, worse, a hard reset elsewhere would discard your commits). This script
#   instead:
#     1. keeps `master` as a pure mirror of upstream (the branch that gets fast-forwarded),
#     2. fast-forwards `master` to origin/master,
#     3. rebases your `swxtch` commits on top of the new `master`,
#     4. THEN (on swxtch) runs `bun install` + `gbrain post-upgrade`.
#
#   Build steps run on the CUSTOM branch AFTER the rebase — never on the mirror. (The
#   sibling gstack-safe-update runs ./setup on the mirror first, which dirties tracked
#   files and aborts the subsequent checkout; gbrain avoids that class of bug entirely.)
#
#   Your work on `$CUSTOM_BRANCH` is replayed via rebase, never reset away. The rebased
#   branch is left LOCAL: this script never force-pushes the shared fork. Review, then
#   push yourself:  git push --force-with-lease swxtch swxtch
#
# Usage:
#   gbrain-safe-update [--dry-run] [--check] [--no-backup] [custom_branch]
#
# Env overrides:
#   GBRAIN_DIR        install dir            (default: ~/tools/gbrain)
#   GBRAIN_TRACK      upstream mirror branch (default: master)
#   GBRAIN_CUSTOM     customization branch   (default: swxtch, or $1)
#   GBRAIN_REMOTE     upstream remote        (default: origin)
#   GBRAIN_LINK       PATH symlink to maintain (default: ~/.local/bin/gbrain-safe-update;
#                     set empty to disable the self-link)
#
# Self-survival:
#   This script is TRACKED on the customization branch only. When it checks out
#   `master` (where the file does not exist) git removes it from the working tree —
#   which would corrupt a still-running bash process reading from that path. So the
#   first thing we do is re-exec from a private temp copy; from then on the running
#   image is independent of any branch switch the script performs. The temp copy
#   deletes itself on exit.
if [ -z "${_GBSU_REEXEC:-}" ]; then
  _gbsu_self="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
  _gbsu_tmp="$(mktemp "${TMPDIR:-/tmp}/gbrain-safe-update.XXXXXX")"
  cat "$_gbsu_self" > "$_gbsu_tmp"
  chmod +x "$_gbsu_tmp"
  export _GBSU_REEXEC=1
  exec bash "$_gbsu_tmp" "$@"
fi
trap 'rm -f -- "$0"' EXIT   # $0 is the temp copy under re-exec — clean it up

set -euo pipefail

# ---- config -----------------------------------------------------------------
INSTALL_DIR="${GBRAIN_DIR:-$HOME/tools/gbrain}"
TRACK_BRANCH="${GBRAIN_TRACK:-master}"
REMOTE="${GBRAIN_REMOTE:-origin}"
# NOTE: ${VAR-default} (no colon) so an explicitly-empty GBRAIN_LINK stays
# empty and disables the self-link, as the usage header documents. The `:-`
# form treated empty as unset and silently relinked the default path.
LINK_PATH="${GBRAIN_LINK-$HOME/.local/bin/gbrain-safe-update}"
# GBRAIN_HOME is a PARENT dir: gbrain's own configDir() appends '.gbrain' to it
# (src/core/config.ts), so GBRAIN_HOME=/srv/x means the brain lives at
# /srv/x/.gbrain. Treating the override as the final directory — which this
# script used to do — inspects and backs up the WRONG path under any override.
if [ -n "${GBRAIN_HOME:-}" ]; then
  BRAIN_DIR="${GBRAIN_HOME%/}/.gbrain"
else
  BRAIN_DIR="$HOME/.gbrain"
fi

DRY_RUN=0
CHECK_ONLY=0
NO_BACKUP=0
CUSTOM_ARG=""
for arg in "$@"; do
  case "$arg" in
    --dry-run)   DRY_RUN=1 ;;
    --check)     CHECK_ONLY=1 ;;
    --no-backup) NO_BACKUP=1 ;;
    -h|--help)   sed -n '2,30p' "$0"; exit 0 ;;
    -*) echo "unknown flag: $arg" >&2; exit 2 ;;
    *)  CUSTOM_ARG="$arg" ;;
  esac
done
CUSTOM_BRANCH="${GBRAIN_CUSTOM:-${CUSTOM_ARG:-swxtch}}"

# ---- helpers ----------------------------------------------------------------
say()  { printf '\033[1;36m▸ %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m✓ %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m! %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m✗ %s\033[0m\n' "$*" >&2; exit 1; }
run()  { if [ "$DRY_RUN" = 1 ]; then printf '  [dry-run]'; printf ' %q' "$@"; printf '\n'; else "$@"; fi; }

# version lives in package.json (gbrain runs from source; `gbrain --version` may be
# a stale globally-resolved build, so read the tree we are actually updating)
read_version() {
  grep -m1 '"version"' "$INSTALL_DIR/package.json" 2>/dev/null \
    | sed 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/' || echo unknown
}

# Idempotently point $LINK_PATH at the in-repo canonical script. A symlink (not a
# copy) means the PATH entry always tracks the committed branch version.
ensure_symlink() {
  [ -n "$LINK_PATH" ] || return 0                      # disabled via empty GBRAIN_LINK
  local canonical="$INSTALL_DIR/scripts/gbrain-safe-update"
  if [ -L "$LINK_PATH" ] && [ "$(readlink "$LINK_PATH")" = "$canonical" ]; then
    return 0
  fi
  if [ "$DRY_RUN" = 1 ]; then
    echo "  [dry-run] ln -sfn '$canonical' '$LINK_PATH'"
    return 0
  fi
  if [ -e "$LINK_PATH" ] && [ ! -L "$LINK_PATH" ]; then
    if ! grep -q 'gbrain-safe-update — upgrade gbrain' "$LINK_PATH" 2>/dev/null; then
      warn "$LINK_PATH exists and isn't ours — leaving it alone (set GBRAIN_LINK to relocate)"
      return 0
    fi
  fi
  mkdir -p "$(dirname "$LINK_PATH")" 2>/dev/null \
    || { warn "cannot create $(dirname "$LINK_PATH") — skipping self-link"; return 0; }
  if ln -sfn "$canonical" "$LINK_PATH" 2>/dev/null; then
    say "Linked $LINK_PATH → scripts/gbrain-safe-update"
  else
    warn "could not create symlink at $LINK_PATH"
  fi
}

# ---- preflight --------------------------------------------------------------
[ -d "$INSTALL_DIR/.git" ] || die "no git install at $INSTALL_DIR (set GBRAIN_DIR)"
cd "$INSTALL_DIR"
INSTALL_DIR="$PWD"   # normalize to absolute so the symlink target is stable

if [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ] || [ -f .git/MERGE_HEAD ]; then
  die "a rebase/merge is already in progress in $INSTALL_DIR — resolve it first"
fi

git show-ref --verify --quiet "refs/heads/$TRACK_BRANCH" \
  || die "tracking branch '$TRACK_BRANCH' does not exist"

ORIG_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
OLD_VERSION="$(read_version)"

say "Install:   $INSTALL_DIR"
say "Version:   $OLD_VERSION"
say "Branches:  track=$TRACK_BRANCH  custom=$CUSTOM_BRANCH  (currently on $ORIG_BRANCH)"

ensure_symlink

# ---- fetch + report what's upstream ----------------------------------------
say "Fetching $REMOTE…"
git fetch --quiet "$REMOTE"

UPSTREAM="$REMOTE/$TRACK_BRANCH"
git show-ref --verify --quiet "refs/remotes/$UPSTREAM" \
  || die "$UPSTREAM not found after fetch"

BEHIND="$(git rev-list --count "$TRACK_BRANCH..$UPSTREAM")"   # commits upstream has, mirror lacks
AHEAD="$(git rev-list --count "$UPSTREAM..$TRACK_BRANCH")"    # local-only commits on the mirror

if [ "$AHEAD" != 0 ]; then
  die "$TRACK_BRANCH has $AHEAD local commit(s) not in $UPSTREAM.
   '$TRACK_BRANCH' is meant to mirror upstream and gets fast-forwarded only.
   Move those commits to '$CUSTOM_BRANCH' first, then re-run."
fi

if [ "$BEHIND" = 0 ]; then
  ok "$TRACK_BRANCH already up to date with $UPSTREAM (v$OLD_VERSION)."
else
  say "$BEHIND new upstream commit(s) on $UPSTREAM (showing newest 15):"
  git --no-pager log --oneline -15 "$TRACK_BRANCH..$UPSTREAM" | sed 's/^/    /'
fi

if git show-ref --verify --quiet "refs/heads/$CUSTOM_BRANCH"; then
  CUSTOM_AHEAD="$(git rev-list --count "$UPSTREAM..$CUSTOM_BRANCH")"
  say "$CUSTOM_BRANCH carries $CUSTOM_AHEAD commit(s) to replay onto the new $TRACK_BRANCH."
fi

# ---- write-through posture gate --------------------------------------------
#
# Placed HERE, before the stash and the rebase, because the rebase is the
# irreversible step. The `gbrain` CLI is bun-linked to this checkout, so the
# instant `git rebase` lands, every new CLI process on the box — capture,
# `brainstorm --save`, cron sync, minion workers — runs the new code. The HTTP
# server is not the only disk sink, which is why round-2's placement in front
# of the explicit restart established nothing: the unit is enabled with
# `Restart=on-failure` and `WantedBy=default.target`, so systemd re-activates
# it on the next crash, login or reboot regardless of what this script skips.
#
# SCOPED to the deployment it was written for. `gbrain-http.service` being
# installed is what makes "shared, DB-authoritative brain" true; on a box with
# no unit this is an ordinary PGLite/file-authoritative brain, where an unset
# key — the fork's inherited mirror-on posture — is CORRECT, and telling the
# operator to run `sync.write_through false` there would disable the .md mirror
# that IS that brain's source of truth. So: no unit, no gate, no probe, no
# advice.
#
# What this establishes and what it does not: it establishes that at this
# moment the DB-plane posture is decided, and refuses to put new code on the
# box while it is not. It cannot establish that the posture stays decided —
# the flag is DB-backed and any client can change it later. No deploy-time
# check can promise more than that, and the message does not pretend to.
HTTP_SERVICE="${GBRAIN_HTTP_SERVICE:-gbrain-http.service}"
if command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$HTTP_SERVICE" >/dev/null 2>&1; then
  WT_STATE="unknown:probe-not-run"
  WT_PROBE="$INSTALL_DIR/deploy/local-http/write-through-probe.ts"
  if ! command -v bun >/dev/null 2>&1; then
    WT_STATE="unknown:bun-not-on-path"
  elif [ ! -r "$WT_PROBE" ]; then
    WT_STATE="unknown:probe-missing"
  else
    WT_STATE="$(bun "$WT_PROBE" 2>/dev/null | tail -1 || true)"
    [ -n "$WT_STATE" ] || WT_STATE="unknown:probe-no-output"
  fi
  case "$WT_STATE" in
    disabled) ok "sync.write_through is off — brain stays DB-only." ;;
    *)
      if [ "${GBRAIN_ALLOW_WRITE_THROUGH:-}" = "1" ]; then
        warn "$WT_STATE — proceeding on GBRAIN_ALLOW_WRITE_THROUGH=1."
      else
        die "$WT_STATE — refusing to update $INSTALL_DIR.
   $HTTP_SERVICE is installed, so this box serves the shared DB-authoritative
   brain, and upstream's sync.write_through flag FAILS OPEN. Rebasing would put
   the new code behind every gbrain process here — the HTTP server, and also
   capture, 'brainstorm --save', cron sync and minion workers, all bun-linked to
   this checkout — each writing a .md mirror into the registered source's tree.
   Nothing has been changed. Decide once:
     gbrain config set sync.write_through false   # DB-only, then re-run this
     GBRAIN_ALLOW_WRITE_THROUGH=1 <this script>   # keep the mirrors, on purpose"
      fi ;;
  esac
fi

if [ "$CHECK_ONLY" = 1 ]; then
  exit 0
fi

# ---- stash dirty working tree ----------------------------------------------
STASHED=0
if ! git diff --quiet || ! git diff --cached --quiet; then
  warn "Working tree is dirty — stashing before update."
  run git stash push -u -m "gbrain-safe-update auto-stash"
  # only mark stashed when we actually stashed — in --dry-run the push above is
  # a no-op, so restore_stash must NOT run a real `git stash pop` (would mutate).
  if [ "$DRY_RUN" != 1 ]; then STASHED=1; fi
fi

restore_stash() {
  if [ "$STASHED" = 1 ]; then
    say "Restoring stashed changes…"
    git stash pop || warn "stash pop hit conflicts — resolve manually (see: git stash list)"
  fi
}

# ---- update the mirror branch (fast-forward only; never dirtied) ------------
if [ "$BEHIND" != 0 ]; then
  say "Updating $TRACK_BRANCH → $UPSTREAM…"
  run git checkout --quiet "$TRACK_BRANCH"
  run git merge --ff-only "$UPSTREAM"   # safe: we proved AHEAD=0, so FF always works
  ok "$TRACK_BRANCH now at $(git rev-parse --short "$UPSTREAM")"
fi

# ---- rebase the customization branch onto the fresh mirror -----------------
REBASED=0
if git show-ref --verify --quiet "refs/heads/$CUSTOM_BRANCH"; then
  CUSTOM_AHEAD="$(git rev-list --count "$TRACK_BRANCH..$CUSTOM_BRANCH")"
  if [ "$CUSTOM_AHEAD" = 0 ]; then
    say "$CUSTOM_BRANCH has no commits beyond $TRACK_BRANCH — fast-forwarding."
    run git checkout --quiet "$CUSTOM_BRANCH"
    run git merge --ff-only "$TRACK_BRANCH" || warn "could not fast-forward $CUSTOM_BRANCH"
  else
    say "Rebasing $CUSTOM_BRANCH ($CUSTOM_AHEAD commit(s)) onto $TRACK_BRANCH…"
    git --no-pager log --oneline "$TRACK_BRANCH..$CUSTOM_BRANCH" | sed 's/^/    /'
    run git checkout --quiet "$CUSTOM_BRANCH"
    if [ "$DRY_RUN" = 1 ]; then
      echo "  [dry-run] git rebase $TRACK_BRANCH"
    else
      # A no-op rebase (BEHIND=0: mirror did not advance) exits 0 having moved
      # nothing — that must NOT arm the upgrade block, or a plain no-change run
      # would still bun install, pg_dump the LIVE brain, run migrations against
      # it, and restart the service (dropping every connected session).
      PRE_REBASE_HEAD="$(git rev-parse HEAD)"
      if git rebase "$TRACK_BRANCH"; then
        if [ "$(git rev-parse HEAD)" = "$PRE_REBASE_HEAD" ]; then
          ok "Rebase was a no-op — $CUSTOM_BRANCH already sits on $TRACK_BRANCH; nothing advanced."
        else
          ok "Rebase clean."
          REBASED=1
        fi
      else
        git rebase --abort
        restore_stash
        die "Rebase hit conflicts and was ABORTED — $CUSTOM_BRANCH is untouched.
   Resolve manually:  cd $INSTALL_DIR && git checkout $CUSTOM_BRANCH && git rebase $TRACK_BRANCH"
      fi
    fi
  fi
else
  warn "customization branch '$CUSTOM_BRANCH' does not exist — skipping rebase"
fi

# ---- build steps: ON the custom branch, AFTER the rebase --------------------
# (bun install only touches gitignored node_modules; gbrain post-upgrade runs DB
#  migrations against the brain in $BRAIN_DIR. Both run here so they match the
#  rebased source — and so the mirror branch is never left dirty.)
if [ "$BEHIND" != 0 ] || [ "$REBASED" = 1 ]; then
  if command -v bun >/dev/null 2>&1; then
    say "Installing dependencies (bun install)…"
    run bun install
  else
    warn "bun not on PATH — skipping dependency install"
  fi

  # back up the brain before running migrations (skippable with --no-backup).
  # gbrain post-upgrade runs apply-migrations against the LIVE brain. Engine-aware:
  #   postgres -> best-effort pg_dump snapshot. Supabase PITR/WAL-G is the primary
  #               recovery net; this is a convenient logical restore point. Non-fatal.
  #   pglite   -> copy the local brain dir (the only net for an embedded brain).
  if [ "$NO_BACKUP" != 1 ]; then
    # The engine read decides WHICH backup to take, so a failed read must not
    # quietly become "pglite": under a Postgres brain that arm matches nothing,
    # no snapshot is written, and the script proceeds to run migrations against
    # the live brain with no net — the exact opposite of what this block is
    # for. Read through the CLI's own resolution first (file plane wins, and it
    # honours GBRAIN_HOME the way the runtime does), fall back to reading the
    # canonical config.json directly for a box whose CLI is mid-upgrade, and
    # abort loudly if neither answers.
    ENGINE=""
    if command -v gbrain >/dev/null 2>&1; then
      ENGINE="$(gbrain config get engine --raw 2>/dev/null | tail -1 || true)"
    fi
    case "$ENGINE" in
      postgres|pglite) ;;
      *)
        if command -v bun >/dev/null 2>&1 && [ -r "$BRAIN_DIR/config.json" ]; then
          ENGINE="$(bun -e 'const f=process.argv[1];const j=JSON.parse(require("fs").readFileSync(f,"utf8"));process.stdout.write(String(j.engine??""))' "$BRAIN_DIR/config.json" 2>/dev/null || true)"
        fi
        ;;
    esac
    case "$ENGINE" in
      postgres|pglite) ;;
      *)
        die "Cannot determine the brain engine (read '$BRAIN_DIR/config.json' and 'gbrain config get engine'; got '${ENGINE:-<empty>}').
   Refusing to run migrations against a live brain with no backup.
   Fix the config, or re-run with --no-backup to accept that risk deliberately."
        ;;
    esac
    mkdir -p "$BRAIN_DIR/backups"
    TS="$(date +%Y%m%d-%H%M%S)"
    if [ "$ENGINE" = "postgres" ]; then
      BK="$BRAIN_DIR/backups/brain-pgdump-$TS.sql.gz"
      say "Snapshotting Postgres brain → $BK (best-effort; Supabase PITR/WAL-G is the primary net)…"
      if [ "$DRY_RUN" = 1 ]; then
        echo "  [dry-run] pg_dump <database_url> | gzip > $BK"
      elif ! command -v pg_dump >/dev/null 2>&1; then
        warn "pg_dump not on PATH — skipping snapshot (relying on Supabase PITR)."
      else
        # Same canonical path as the engine read, and the same posture: an
        # unreadable URL is a visible skip, not a `set -e` death mid-upgrade.
        DBURL=""
        if command -v gbrain >/dev/null 2>&1; then
          DBURL="$(gbrain config get database_url --raw 2>/dev/null | tail -1 || true)"
        fi
        if [ -z "$DBURL" ] && command -v bun >/dev/null 2>&1 && [ -r "$BRAIN_DIR/config.json" ]; then
          DBURL="$(bun -e 'const f=process.argv[1];const j=JSON.parse(require("fs").readFileSync(f,"utf8"));process.stdout.write(String(j.database_url??""))' "$BRAIN_DIR/config.json" 2>/dev/null || true)"
        fi
        if [ -z "$DBURL" ]; then
          warn "could not read database_url — skipping snapshot (relying on Supabase PITR). (--no-backup to silence)"
        elif PGSSLMODE=require pg_dump --no-owner --no-privileges "$DBURL" | gzip > "$BK"; then
          ok "Brain snapshot saved ($(du -h "$BK" | cut -f1))."
        else
          rm -f "$BK"
          warn "pg_dump snapshot failed — relying on Supabase PITR/WAL-G. (--no-backup to skip)"
        fi
      fi
    else
      # The PGLite store is `config.database_path` (pglite-engine.ts reads
      # `config.database_path || undefined`), which `gbrain init --path`
      # customises; only its DEFAULT is <brain dir>/brain.pglite. Copying the
      # literal default meant a custom-path brain matched no arm at all, wrote
      # nothing, printed nothing, and fell through to `gbrain post-upgrade` —
      # live migrations with no net. Same "config value the script cannot
      # resolve → silently no snapshot" shape as the database_url arm above,
      # so it is resolved the same way and, like every other arm here, always
      # reports.
      PGPATH=""
      if command -v gbrain >/dev/null 2>&1; then
        PGPATH="$(gbrain config get database_path --raw 2>/dev/null | tail -1 || true)"
      fi
      if [ -z "$PGPATH" ] && command -v bun >/dev/null 2>&1 && [ -r "$BRAIN_DIR/config.json" ]; then
        PGPATH="$(bun -e 'const f=process.argv[1];const j=JSON.parse(require("fs").readFileSync(f,"utf8"));process.stdout.write(String(j.database_path??""))' "$BRAIN_DIR/config.json" 2>/dev/null || true)"
      fi
      # Whether the path was CONFIGURED decides how a missing store is read.
      PGPATH_EXPLICIT=1
      if [ -z "$PGPATH" ]; then PGPATH="$BRAIN_DIR/brain.pglite"; PGPATH_EXPLICIT=0; fi
      if [ -e "$PGPATH" ]; then
        BK="$BRAIN_DIR/backups/$(basename "$PGPATH").bak-$TS"
        say "Backing up PGLite brain ($PGPATH) → $BK"
        run cp -a "$PGPATH" "$BK"
      elif [ "$PGPATH_EXPLICIT" = 1 ]; then
        # database_path names a store that is not there. That is a broken
        # config, not an empty machine, and migrations are about to run.
        die "PGLite store not found at '$PGPATH' (from the configured database_path).
   Refusing to run migrations against a live brain with no backup.
   Fix database_path, or re-run with --no-backup to accept that risk deliberately."
      else
        # No configured path and nothing at the default: there is no PGLite
        # brain on this machine to snapshot. Say so — every other arm of this
        # block reports, and silence is what let the original defect hide.
        warn "no PGLite store at the default $PGPATH and no database_path configured — nothing to back up."
      fi
    fi
  fi

  if command -v gbrain >/dev/null 2>&1; then
    say "Running gbrain post-upgrade (migration notes + data fixes)…"
    run gbrain post-upgrade || warn "gbrain post-upgrade reported errors (review above)"
  else
    warn "gbrain not on PATH — run 'gbrain post-upgrade' manually after this"
  fi

  # Restart the shared HTTP MCP server so it loads the freshly-rebased code.
  # The `gbrain` CLI is bun-linked to this checkout, so a long-running
  # `gbrain serve --http` (deploy/local-http/) keeps the OLD code in memory until
  # restarted. Non-fatal + loopback-only: machines without the service just skip.
  # ONE port contract, and the installed unit is what holds it.
  # deploy/local-http/setup.sh templates GBRAIN_HTTP_PORT into the unit's
  # ExecStart, so a literal 8787 here meant every update of a moved service
  # spent 30s probing a port nothing listens on and then reported a false
  # "did not pass health" — unless the operator also set a second,
  # undocumented GBRAIN_HTTP_HEALTH. Read the port back out of the unit this
  # script is about to restart (the same `systemctl --user cat` output the
  # guard below already needs), so the two can't disagree. The env override
  # still wins for a service fronted by a proxy or on another host.
  # `|| true`: with `set -euo pipefail` a failing command substitution in an
  # assignment kills the script, and `systemctl --user cat` exits non-zero
  # whenever the unit is absent — which is the ordinary case on a machine that
  # doesn't run the service. Falling back to the default port is correct there;
  # dying mid-upgrade is not.
  HTTP_PORT=""
  if command -v systemctl >/dev/null 2>&1; then
    HTTP_PORT="$(systemctl --user cat "$HTTP_SERVICE" 2>/dev/null \
      | sed -n 's/.*--port[= ]\([0-9][0-9]*\).*/\1/p' | tail -1 || true)"
  fi
  HTTP_HEALTH="${GBRAIN_HTTP_HEALTH:-http://127.0.0.1:${HTTP_PORT:-8787}/health}"
  if command -v systemctl >/dev/null 2>&1 && systemctl --user cat "$HTTP_SERVICE" >/dev/null 2>&1; then
    say "Restarting $HTTP_SERVICE to load the updated code…"
    run systemctl --user restart "$HTTP_SERVICE"
    if [ "$DRY_RUN" != 1 ]; then
      _gb_healthy=0
      for _ in $(seq 1 30); do
        if curl -fsS --max-time 3 "$HTTP_HEALTH" >/dev/null 2>&1; then _gb_healthy=1; break; fi
        sleep 1
      done
      if [ "$_gb_healthy" = 1 ]; then
        ok "$HTTP_SERVICE healthy after restart."
      else
        warn "$HTTP_SERVICE did not pass $HTTP_HEALTH within 30s — check: journalctl --user -u $HTTP_SERVICE -n 40"
      fi
    fi
  else
    warn "$HTTP_SERVICE not installed (systemd user) — skipping HTTP MCP server restart."
  fi

  if [ "$DRY_RUN" != 1 ]; then
    mkdir -p "$BRAIN_DIR"
    echo "$OLD_VERSION" > "$BRAIN_DIR/just-upgraded-from" 2>/dev/null || true
  fi
fi

# ---- return to where we started + restore stash ----------------------------
TARGET_BRANCH="$CUSTOM_BRANCH"
git show-ref --verify --quiet "refs/heads/$CUSTOM_BRANCH" || TARGET_BRANCH="$ORIG_BRANCH"
run git checkout --quiet "$TARGET_BRANCH"
restore_stash

NEW_VERSION="$(read_version)"
echo
if [ "$OLD_VERSION" = "$NEW_VERSION" ]; then
  ok "Done — still on v$NEW_VERSION (no upstream change). Now on '$(git rev-parse --abbrev-ref HEAD)'."
else
  ok "Done — upgraded v$OLD_VERSION → v$NEW_VERSION. Now on '$(git rev-parse --abbrev-ref HEAD)'."
fi
[ "$STASHED" = 1 ] && warn "Auto-stash was popped — double-check your working tree."
if [ "$REBASED" = 1 ]; then
  warn "$CUSTOM_BRANCH was rebased and now DIVERGES from its pushed fork remote."
  echo "  Review, then publish:  git -C $INSTALL_DIR push --force-with-lease swxtch $CUSTOM_BRANCH"
fi
